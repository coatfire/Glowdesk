# demo  = fictional fixtures, labelled, no real actions (default)
# pilot = fails closed until auth, persistence and providers exist
# Read at build time for static pages: rebuild after changing it.
APP_MODE=demo

# Deployed HTTPS origin used for canonical and share URLs, e.g. https://example.com
NEXT_PUBLIC_APP_URL=

# Only "mock" exists. The mock is refused outside demo mode.
TRY_ON_PROVIDER=mock

# --- Not used yet -----------------------------------------------------------

# Supabase (Phase 2). The service-role key bypasses RLS: server-side only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — expert subscriptions only (Phase 5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Perfect Corp — deferred skin-analysis candidate; adapter is unimplemented.
# Server-side only. Not a try-on provider.
PERFECTCORP_API_KEY=
